# Add this block to the VM's Caddyfile, then reload Caddy from stdin, because
# the Caddyfile is bind-mounted as a single file and rewriting it in place
# orphans the mount:
#
#   docker exec -i caddy caddy validate --config - --adapter caddyfile < Caddyfile
#   docker exec -i caddy caddy reload   --config - --adapter caddyfile < Caddyfile
#
# Point an A record for the host at this machine first, or the ACME HTTP-01
# challenge cannot complete.

# Export SSO_PROXY_SECRET in the Caddy container's environment; use the same
# value as the speech app's SSO_PROXY_SECRET setting.
speech.ifkash.dev {
	encode zstd gzip

	# The MCP server for AI agents. An agent can't complete the Authelia sign-in
	# in a browser, so this path skips forward_auth and the app requires a bearer
	# token instead. Caddy doesn't inject X-SSO-Proxy here, and it strips any
	# Remote-User or X-SSO-Proxy a client sends, so these headers can never
	# carry an identity on this path. The app ignores them on /mcp regardless.
	#
	# `handle` blocks are mutually exclusive and run in order of path
	# specificity, so this block wins over the catch-all below. A bare
	# forward_auth would otherwise sort before reverse_proxy and gate /mcp too.
	#
	# /.well-known/oauth-* skips Authelia too. An MCP client probes it after a
	# 401, and the app answers 404 there; a 302 to the portal would read as a
	# broken OAuth server.
	@mcp path /mcp /mcp/* /.well-known/oauth-*
	handle @mcp {
		reverse_proxy speech:8000 {
			header_up -Remote-User
			header_up -X-SSO-Proxy
			flush_interval -1
			transport http {
				response_header_timeout 30m
				read_timeout 30m
			}
		}
	}

	handle {
		# Authenticate every other request before it reaches the app. The proxy
		# overwrites any client-supplied identity marker with the trusted shared
		# secret.
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User
		}

		# A run is a server-sent event stream that stays open for as long as the
		# exercise takes, so response buffering must be off and the timeouts must
		# outlast the longest GPU lesson.
		reverse_proxy speech:8000 {
			header_up X-SSO-Proxy {$SSO_PROXY_SECRET}
			flush_interval -1
			transport http {
				response_header_timeout 30m
				read_timeout 30m
			}
		}
	}
}
