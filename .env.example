# Copy to .env and fill in. Everything here has a working default except the
# session secret, which you must set before the app faces the internet.

# Auth. Two people share one password; the usernames scope their progress.
APP_USERS=michu,enderboi
APP_PASSWORD=mochimochi

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Set to true once the app is served over HTTPS, so the cookie is not sent
# in the clear.
COOKIE_SECURE=false
SESSION_DAYS=30

# Where progress, drafts, and run history live. A volume in the container.
DATA_DIR=/data

# The local runner's limits. `local_workers` caps how many submissions run at
# once; the other two apply to each one.
LOCAL_WORKERS=2
LOCAL_TIMEOUT_CEILING=180
# Zero leaves the per-process address-space limit off, because numpy and torch
# over-reserve virtual memory. The container's mem_limit bounds resident memory.
LOCAL_MEMORY_MB=0

# RunPod, for the lessons marked `gpu: true`. Leave the endpoint blank and
# those lessons fall back to the local CPU runner.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_GPU=A100-80GB
RUNPOD_TIMEOUT=900
